  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "About 42,000 years ago, something happened on Earth that seemed to break the sky."
    } ]
  }, {
    "tStartMs": 9120,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "There were terrible lightning storms all around the sky and colorful auroras were visible everywhere."
    } ]
  }, {
    "tStartMs": 15880,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Radiation from space started coming directly to Earth, which destroyed the ozone layer."
    } ]
  }, {
    "tStartMs": 21140,
    "dDurationMs": 6520,
    "segs": [ {
      "utf8": "Ultraviolet radiation increased rapidly and a wave of climate change came into the world."
    } ]
  }, {
    "tStartMs": 27660,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "This was a time when humans lived in jungles and caves."
    } ]
  }, {
    "tStartMs": 32660,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "At this time, cave art made by the natives was suddenly gaining popularity."
    } ]
  }, {
    "tStartMs": 39660,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "Scientists believe that due to increasing ultraviolet radiation, humans used these caves as shelters."
    } ]
  }, {
    "tStartMs": 46660,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And during this time, many species completely extinct."
    } ]
  }, {
    "tStartMs": 50660,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "In Australia, giant kangaroos and giant wombats, look at these images, they completely vanished."
    } ]
  }, {
    "tStartMs": 56660,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "In Europe, a species of humans, Neanderthals, has also been cleaned up,"
    } ]
  }, {
    "tStartMs": 61820,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "which is called the closest relative of Homo sapiens."
    } ]
  }, {
    "tStartMs": 65260,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "But the question is, what happened on Earth?"
    } ]
  }, {
    "tStartMs": 68340,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Its answer, was not in the sky, but under our feet,"
    } ]
  }, {
    "tStartMs": 72660,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "hidden in a depth of about 3000 kilometers."
    } ]
  }, {
    "tStartMs": 76380,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "And today, in 2026, something strange is happening in this depth,"
    } ]
  }, {
    "tStartMs": 80560,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "whose signs are now visible even above the Earth."
    } ]
  }, {
    "tStartMs": 83120,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "The region between South America and Africa is where the Hubble-like telescopes data is"
    } ]
  }, {
    "tStartMs": 90120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "showing glitches."
    } ]
  }, {
    "tStartMs": 91120,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "The equipment in the satellites is malfunctioning and some systems have to be shut down for weeks"
    } ]
  }, {
    "tStartMs": 98120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "to prevent them from deteriorating."
    } ]
  }, {
    "tStartMs": 100120,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "That is why this area is called the Bermuda Triangle of space."
    } ]
  }, {
    "tStartMs": 104120,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Let's understand this topic in depth in today's video.\n23\n00:01:53,120 --\u003e 00:01:53,1000\nThose are the"
    } ]
  }, {
    "tStartMs": 114000,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "I want to thank you all for Diwali."
    } ]
  }, {
    "tStartMs": 116460,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "This Diwali, focus on your education and skill development."
    } ]
  }, {
    "tStartMs": 120180,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Learn something new."
    } ]
  }, {
    "tStartMs": 121420,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Increase your knowledge."
    } ]
  }, {
    "tStartMs": 122780,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "And give yourself a gift of a new skill."
    } ]
  }, {
    "tStartMs": 125080,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "To help you in this,"
    } ]
  }, {
    "tStartMs": 126880,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Dhruv Rathee Academy is having a Mega Diwali Sale."
    } ]
  }, {
    "tStartMs": 130240,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "You will get a flat 50% off on all my recorded courses."
    } ]
  }, {
    "tStartMs": 134760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "That means you get a chance to learn your favorite skill at half the price."
    } ]
  }, {
    "tStartMs": 137960,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "If you want to make a career on social media,"
    } ]
  }, {
    "tStartMs": 140620,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "or want to start a YouTube channel,"
    } ]
  }, {
    "tStartMs": 142400,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "then you have the YouTube Blueprint course."
    } ]
  }, {
    "tStartMs": 144700,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "In this, you learn everything from planning, scripting, filming, and editing."
    } ]
  }, {
    "tStartMs": 148140,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "If you're suffering from procrastination in your life,"
    } ]
  }, {
    "tStartMs": 151040,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and you want to achieve your goals better,"
    } ]
  }, {
    "tStartMs": 153320,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and manage your daily life better,"
    } ]
  }, {
    "tStartMs": 155520,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "then you have the Master Time Management course."
    } ]
  }, {
    "tStartMs": 158340,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "Or to learn the fundamentals of AI,"
    } ]
  }, {
    "tStartMs": 160400,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "you can choose the Master Chat GPT course."
    } ]
  }, {
    "tStartMs": 162600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "You get lifetime access to all these courses."
    } ]
  }, {
    "tStartMs": 165200,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Learn on your own time and watch it again whenever you want."
    } ]
  }, {
    "tStartMs": 167940,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "And along with this, there's a great sale on AI Fiesta."
    } ]
  }, {
    "tStartMs": 171240,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "This is an all-in-one AI app that gives you access to more than 100 AI models."
    } ]
  }, {
    "tStartMs": 175560,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Meaning, one platform to access every AI tool in the world."
    } ]
  }, {
    "tStartMs": 179400,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Whether it's to make photos, videos, slides, websites, etc."
    } ]
  }, {
    "tStartMs": 182640,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "You can find the link to all of these in the pinned comment below."
    } ]
  }, {
    "tStartMs": 185040,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Or you can scan this QR code as well."
    } ]
  }, {
    "tStartMs": 187520,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "But hurry up, because this is valid from Diwali to a few days."
    } ]
  }, {
    "tStartMs": 191480,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "And remember, start learning whatever you want to learn from this Diwali."
    } ]
  }, {
    "tStartMs": 197240,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Hello!"
    } ]
  }, {
    "tStartMs": 198240,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "To find the answer to this question,"
    } ]
  }, {
    "tStartMs": 199840,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "we first have to dive under our feet."
    } ]
  }, {
    "tStartMs": 202140,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "The earth below us,"
    } ]
  }, {
    "tStartMs": 203640,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "has mainly four layers."
    } ]
  }, {
    "tStartMs": 205240,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "The crust at the top,"
    } ]
  }, {
    "tStartMs": 206500,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "then the mantle,"
    } ]
  }, {
    "tStartMs": 207740,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "then the outer core,"
    } ]
  }, {
    "tStartMs": 208800,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and finally the inner core."
    } ]
  }, {
    "tStartMs": 210180,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "The outer core is approximately 2250 km thick."
    } ]
  }, {
    "tStartMs": 214340,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "And it is made of melted iron and nickel."
    } ]
  }, {
    "tStartMs": 216940,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "That is, at a depth of approximately 2900 km under our feet,"
    } ]
  }, {
    "tStartMs": 220440,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "there is an entire sea of ​​molten iron."
    } ]
  }, {
    "tStartMs": 223180,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And this sea does not just stay in one place,"
    } ]
  }, {
    "tStartMs": 225580,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "but it keeps on rotating."
    } ]
  }, {
    "tStartMs": 228000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Electric currents are created by this."
    } ]
  }, {
    "tStartMs": 230000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "According to NASA, these currents are hundreds of miles wide."
    } ]
  }, {
    "tStartMs": 233000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And flow at a rate of thousands of miles per hour."
    } ]
  }, {
    "tStartMs": 236000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "As you must have read in school,"
    } ]
  }, {
    "tStartMs": 238000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "electric currents always create a magnetic field."
    } ]
  }, {
    "tStartMs": 241000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So, these currents that flow in the earth,"
    } ]
  }, {
    "tStartMs": 244000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "create a magnetic field of the earth."
    } ]
  }, {
    "tStartMs": 247000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "This is the thing that gives the earth its entire geomagnetic field."
    } ]
  }, {
    "tStartMs": 251000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It is drawn in the school books in such a way,"
    } ]
  }, {
    "tStartMs": 254000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that it is a magnet in the earth."
    } ]
  }, {
    "tStartMs": 256000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "But there is no magnet present there."
    } ]
  }, {
    "tStartMs": 258400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It is actually the melted iron in the earth"
    } ]
  }, {
    "tStartMs": 261040,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that is making the magnetic field."
    } ]
  }, {
    "tStartMs": 263040,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And this magnetic field works like an invisible shield."
    } ]
  }, {
    "tStartMs": 267040,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "It protects us from the dangerous radiation from the sun and space."
    } ]
  }, {
    "tStartMs": 271440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "This magnetic field has a North and South Pole."
    } ]
  }, {
    "tStartMs": 274320,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And the biggest clue to what is going on in the earth"
    } ]
  }, {
    "tStartMs": 277920,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "is this point."
    } ]
  }, {
    "tStartMs": 280720,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Now, here, a very common misconception is made by people."
    } ]
  }, {
    "tStartMs": 283360,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "People confuse this magnetic north pole with the North Pole of the Earth."
    } ]
  }, {
    "tStartMs": 288360,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "People think that this is the only North Pole of the Earth."
    } ]
  }, {
    "tStartMs": 293360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But actually, the Earth has two North Poles."
    } ]
  }, {
    "tStartMs": 296360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The first is the Geographic North Pole."
    } ]
  }, {
    "tStartMs": 298360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "This is actually the true North Pole."
    } ]
  }, {
    "tStartMs": 300360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The northernmost point of the Earth, between the Arctic Ocean."
    } ]
  }, {
    "tStartMs": 303360,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "It is a fixed point."
    } ]
  }, {
    "tStartMs": 304360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The second is the Magnetic North Pole."
    } ]
  }, {
    "tStartMs": 306360,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Visually, this is the place where the Earth's magnetic field lines go directly into the Earth."
    } ]
  }, {
    "tStartMs": 312360,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "And when you use a compass, whether it's a hand compass or a phone compass,"
    } ]
  }, {
    "tStartMs": 318360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "you can see the north of the compass."
    } ]
  }, {
    "tStartMs": 321360,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "The compass that is showing the north is actually the magnetic North Pole."
    } ]
  }, {
    "tStartMs": 325360,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But do you know that the magnetic North Pole never stays in one place?"
    } ]
  }, {
    "tStartMs": 329360,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "It makes an elliptical path of about 120 km every day."
    } ]
  }, {
    "tStartMs": 334360,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "That is, the point that your compass was pointing at this morning,"
    } ]
  }, {
    "tStartMs": 338360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that point has been dragged somewhere else by the evening."
    } ]
  }, {
    "tStartMs": 341360,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "And here's another interesting fact."
    } ]
  }, {
    "tStartMs": 342000,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "Magnetic North Pole is a magnetic South Pole."
    } ]
  }, {
    "tStartMs": 347280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "The compass needle is a small magnet."
    } ]
  }, {
    "tStartMs": 349440,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "You must have read that opposite poles attract magnets."
    } ]
  }, {
    "tStartMs": 353520,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "One magnet's North Pole attracts the other's South Pole."
    } ]
  }, {
    "tStartMs": 357080,
    "dDurationMs": 7100,
    "segs": [ {
      "utf8": "The magnetic South Pole of the compass magnet is attracted to the magnetic North Pole of the Earth."
    } ]
  }, {
    "tStartMs": 364180,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That's why it's called the opposite."
    } ]
  }, {
    "tStartMs": 366180,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "But to keep things simple, we call it the magnetic North Pole."
    } ]
  }, {
    "tStartMs": 370320,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Now the question is, why does this magnetic North Pole keep moving?"
    } ]
  }, {
    "tStartMs": 374120,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "To find out the answer to this, we have to go 200 years ago."
    } ]
  }, {
    "tStartMs": 377600,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "In the Arctic region of Canada, there is a place called the Boothia Peninsula."
    } ]
  }, {
    "tStartMs": 380880,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Not Boothia, Boothia."
    } ]
  }, {
    "tStartMs": 382640,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "In 1831, the British explorer James Clark Ross's ship got stuck in the ice."
    } ]
  }, {
    "tStartMs": 388320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "He had a magnetic needle,"
    } ]
  }, {
    "tStartMs": 390320,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "which was hung from a silk thread."
    } ]
  }, {
    "tStartMs": 392320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And he was looking for a very specific place."
    } ]
  }, {
    "tStartMs": 395040,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "The point where this needle completely bends down."
    } ]
  }, {
    "tStartMs": 400560,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "That is, Magnetic North Pole."
    } ]
  }, {
    "tStartMs": 402660,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "After searching for many days, they finally get this place."
    } ]
  }, {
    "tStartMs": 405100,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "On 1st June 1831."
    } ]
  }, {
    "tStartMs": 408040,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "As soon as they got this point, Ross made a pile of stones there and covered the British flag."
    } ]
  }, {
    "tStartMs": 414120,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "He directly declared it as British Territory."
    } ]
  }, {
    "tStartMs": 417060,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Because he was the first person to reach here."
    } ]
  }, {
    "tStartMs": 419140,
    "dDurationMs": 8380,
    "segs": [ {
      "utf8": "But the surprising thing is that this magnetic North Pole was about 1600 km south of the Geographic North Pole."
    } ]
  }, {
    "tStartMs": 427520,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "You might think that both these North Poles are very close to each other, but they were 1600 km away."
    } ]
  }, {
    "tStartMs": 433140,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And this was when the flag was raised."
    } ]
  }, {
    "tStartMs": 436140,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "After this, this pole started to fall from its place."
    } ]
  }, {
    "tStartMs": 443140,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "In the beginning, its speed was quite slow."
    } ]
  }, {
    "tStartMs": 445140,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "From 1904 to 1990, it was on average only 9-15 km per year."
    } ]
  }, {
    "tStartMs": 453140,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "That is, every day, it was only 25-40 meters."
    } ]
  }, {
    "tStartMs": 456000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "2 cricket pitches."
    } ]
  }, {
    "tStartMs": 458000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "But around 1990, something happened that this magnetic North Pole caught its speed."
    } ]
  }, {
    "tStartMs": 465000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Instead of shifting slowly, it almost started to run."
    } ]
  }, {
    "tStartMs": 469000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "In 1990, its speed of sliding was 55 km per year."
    } ]
  }, {
    "tStartMs": 473000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "That means it was sliding about 150 meters every day."
    } ]
  }, {
    "tStartMs": 476000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Between 1990 and 2005, its speed was 50 to 60 km per year."
    } ]
  }, {
    "tStartMs": 482000,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "In a few years, its speed had increased by 4 times."
    } ]
  }, {
    "tStartMs": 486440,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "By the year 2000, it had left the land of Canada,"
    } ]
  }, {
    "tStartMs": 489840,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and crossed the Western Hemisphere."
    } ]
  }, {
    "tStartMs": 492040,
    "dDurationMs": 6740,
    "segs": [ {
      "utf8": "In October 2017, it was only 390 km away from the Geographic North Pole."
    } ]
  }, {
    "tStartMs": 498780,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Today, the magnetic North Pole is in the Eastern Hemisphere,"
    } ]
  }, {
    "tStartMs": 501580,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "and is moving towards Siberia, Russia."
    } ]
  }, {
    "tStartMs": 504440,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "If you want to understand it in the Indian context,"
    } ]
  }, {
    "tStartMs": 506540,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "think of it as if the magnetic North Pole was in Delhi before,"
    } ]
  }, {
    "tStartMs": 509820,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "it has now advanced beyond the Kanyakumari."
    } ]
  }, {
    "tStartMs": 513140,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "This is the reason why on 4 February 2019,"
    } ]
  }, {
    "tStartMs": 515640,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "American scientists issued an emergency update on the World Magnetic Model."
    } ]
  }, {
    "tStartMs": 520860,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "This is the model that tracks the magnetic field of the Earth,"
    } ]
  }, {
    "tStartMs": 524000,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "and is used for navigation of ships and aircraft,"
    } ]
  }, {
    "tStartMs": 526660,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "as well as Google Maps."
    } ]
  }, {
    "tStartMs": 529960,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "This model is usually updated once every 5 years."
    } ]
  }, {
    "tStartMs": 533000,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "But this time, it had to be updated 10 months earlier."
    } ]
  }, {
    "tStartMs": 536700,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Because the magnetic North Pole was shifting so rapidly"
    } ]
  }, {
    "tStartMs": 540140,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "that the world map was wrong."
    } ]
  }, {
    "tStartMs": 542560,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "You might wonder,"
    } ]
  }, {
    "tStartMs": 544300,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "if an invisible point is slipping under the ice,"
    } ]
  }, {
    "tStartMs": 547840,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "what difference does it make to us?"
    } ]
  }, {
    "tStartMs": 549740,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "In reality, it makes a huge difference."
    } ]
  }, {
    "tStartMs": 551740,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And the most visible example is the airports."
    } ]
  }, {
    "tStartMs": 554460,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "The names of the runways in the airports around the world"
    } ]
  }, {
    "tStartMs": 556880,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "are kept in numbers."
    } ]
  }, {
    "tStartMs": 558340,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "18, 27, 36."
    } ]
  }, {
    "tStartMs": 560620,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "These numbers are not random."
    } ]
  }, {
    "tStartMs": 562300,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "They come from the compass heading of the runway."
    } ]
  }, {
    "tStartMs": 564540,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "means it is pointing 180 degrees according to the compass."
    } ]
  }, {
    "tStartMs": 570000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "If the magnetic north is shaken, the real compass heading of the runway and its number will be different."
    } ]
  }, {
    "tStartMs": 575000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "For example, if a plane wants to land on runway 18, it means that the plane has to come on a 180 degree heading."
    } ]
  }, {
    "tStartMs": 582000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "But if the magnetic north pole direction has changed, then that 180 degree heading can go in a slightly different direction."
    } ]
  }, {
    "tStartMs": 589000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "When this direction changes a little, the airport has to change the name of the runway."
    } ]
  }, {
    "tStartMs": 594000,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Because in 2009, the Fairbanks International Airport in Alaska"
    } ]
  }, {
    "tStartMs": 597780,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "had to change its runway name from 1L19R to 2L20R."
    } ]
  }, {
    "tStartMs": 603440,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "And the speed at which the North Pole is moving,"
    } ]
  }, {
    "tStartMs": 605880,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "it is estimated that it will have to change its name again around 2033."
    } ]
  }, {
    "tStartMs": 610320,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "But this is not limited to only airports."
    } ]
  }, {
    "tStartMs": 612520,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "It also affects your daily life."
    } ]
  }, {
    "tStartMs": 614820,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Google Maps takes your location out of GPS."
    } ]
  }, {
    "tStartMs": 618000,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "But how you are standing,"
    } ]
  }, {
    "tStartMs": 620200,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "is shown by the compass of your phone."
    } ]
  }, {
    "tStartMs": 622400,
    "dDurationMs": 6440,
    "segs": [ {
      "utf8": "That means if the magnetic North Pole is being pulled and the model is not updated, then the compass will show the wrong direction."
    } ]
  }, {
    "tStartMs": 629320,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "And the biggest thing, it will also affect the navigation systems of the militaries of all countries."
    } ]
  }, {
    "tStartMs": 634800,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So, roughly speaking, it has a very big impact."
    } ]
  }, {
    "tStartMs": 638140,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "But now the question is, why is the North Pole being pulled so much?"
    } ]
  }, {
    "tStartMs": 642200,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Why is it shifting so fast?"
    } ]
  }, {
    "tStartMs": 644260,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "Now, as I told you, this magnetic North Pole is the result of melted iron in the outer core of the earth."
    } ]
  }, {
    "tStartMs": 650260,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "If this pole is running so fast, it means that something is changing below."
    } ]
  }, {
    "tStartMs": 655540,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "We won't get the answer to what is changing below,"
    } ]
  }, {
    "tStartMs": 659860,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "because we don't have any machine that can go below 3000 km of the Earth."
    } ]
  }, {
    "tStartMs": 665140,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "We have the answer from satellites."
    } ]
  }, {
    "tStartMs": 668900,
    "dDurationMs": 6640,
    "segs": [ {
      "utf8": "In May 2020, Philip Livermore and his colleagues published a paper in Nature Geoscience."
    } ]
  }, {
    "tStartMs": 675540,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "And in this paper,"
    } ]
  }, {
    "tStartMs": 676540,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "using 20 years of satellite data,"
    } ]
  }, {
    "tStartMs": 679240,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "the reason for this whole puzzle was told."
    } ]
  }, {
    "tStartMs": 681920,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "He said that in the Earth,"
    } ]
  }, {
    "tStartMs": 684000,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "on the boundary of the mantle and the core, the magnetic field is not the same."
    } ]
  }, {
    "tStartMs": 687500,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And there are two large lobes, where the magnetic field is concentrated."
    } ]
  }, {
    "tStartMs": 691500,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "One of these lobes is below Canada and the other below Siberia."
    } ]
  }, {
    "tStartMs": 695000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Between these two lobes, there is a tug of war going on."
    } ]
  }, {
    "tStartMs": 698000,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "And both the magnetic North Pole are pulling towards each other."
    } ]
  }, {
    "tStartMs": 702500,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Now, when these two were equally strong, the pole was stuck between them."
    } ]
  }, {
    "tStartMs": 706000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "But between 1970 and 1999, the pattern of the flow of iron flowing in the outer core changed."
    } ]
  }, {
    "tStartMs": 713000,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And that change made the Canada lobe longer."
    } ]
  }, {
    "tStartMs": 716840,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Now, because it stretched,"
    } ]
  }, {
    "tStartMs": 718880,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "it meant that its strength was no longer concentrated in one place."
    } ]
  }, {
    "tStartMs": 722340,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It started to weaken."
    } ]
  }, {
    "tStartMs": 723540,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "And when the magnetic lobe below Canada weakened,"
    } ]
  }, {
    "tStartMs": 726640,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "the actual magnetic North Pole"
    } ]
  }, {
    "tStartMs": 730280,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "shifted towards Siberia."
    } ]
  }, {
    "tStartMs": 732200,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Now, you might not find this very interesting,"
    } ]
  }, {
    "tStartMs": 735280,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "but the problem is that this is where the real fear begins."
    } ]
  }, {
    "tStartMs": 738760,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Because sometimes, this tug of war gets so bad,"
    } ]
  }, {
    "tStartMs": 742340,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "that these magnetic poles flip."
    } ]
  }, {
    "tStartMs": 745380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And this has happened before."
    } ]
  }, {
    "tStartMs": 747180,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Hundreds of times."
    } ]
  }, {
    "tStartMs": 750540,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "In 1905, a French physicist, Bernard Brunais,"
    } ]
  }, {
    "tStartMs": 753860,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "found out that a very interesting thing was found in a village called Pontferrin."
    } ]
  }, {
    "tStartMs": 758860,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "During the digging for the road,"
    } ]
  }, {
    "tStartMs": 761100,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "a layer of lava was found right above the terra cotta, or the solid soil."
    } ]
  }, {
    "tStartMs": 766380,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Brunais was looking for the same layer of soil."
    } ]
  }, {
    "tStartMs": 768580,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Because when lava flows and cools down,"
    } ]
  }, {
    "tStartMs": 770580,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "the magnetic particles inside it,"
    } ]
  }, {
    "tStartMs": 772580,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "freeze in the direction of the magnetic field at that time."
    } ]
  }, {
    "tStartMs": 776000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "This soil had become a stone compass."
    } ]
  }, {
    "tStartMs": 778700,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "A compass that had records of the magnetic fields of hundreds of thousands of years ago."
    } ]
  }, {
    "tStartMs": 784580,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So Brunhuis took it to his lab and did a research."
    } ]
  }, {
    "tStartMs": 787580,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "After the research, he found out that"
    } ]
  }, {
    "tStartMs": 789580,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "the magnetic direction inside this soil,"
    } ]
  }, {
    "tStartMs": 793000,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "was the opposite of the current direction."
    } ]
  }, {
    "tStartMs": 796420,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "That is, at that time, the magnetic North Pole"
    } ]
  }, {
    "tStartMs": 798000,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "was the magnetic south pole,"
    } ]
  }, {
    "tStartMs": 800520,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "and the magnetic south pole was the magnetic north pole."
    } ]
  }, {
    "tStartMs": 803680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "But at that time, this claim was so sensational"
    } ]
  }, {
    "tStartMs": 806240,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "that scientists made fun of it for decades."
    } ]
  }, {
    "tStartMs": 809520,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "They couldn't believe this man's research,"
    } ]
  }, {
    "tStartMs": 811880,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "that this was impossible."
    } ]
  }, {
    "tStartMs": 814640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "But in 1960,"
    } ]
  }, {
    "tStartMs": 816320,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "a map in the ocean proved Brunhuis right."
    } ]
  }, {
    "tStartMs": 820320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "At that time, magnetometers were tied behind the ships"
    } ]
  }, {
    "tStartMs": 823200,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "to do sea bed surveys."
    } ]
  }, {
    "tStartMs": 825040,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "And they found a pattern of magnetic lines on the seabed"
    } ]
  }, {
    "tStartMs": 828740,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "that matched the lines on a zebra."
    } ]
  }, {
    "tStartMs": 831440,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "These lines were the record of the changing magnetic field of the earth."
    } ]
  }, {
    "tStartMs": 834780,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "That is, sometimes the direction of the field was one way,"
    } ]
  }, {
    "tStartMs": 837280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and sometimes the opposite."
    } ]
  }, {
    "tStartMs": 839280,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "And the most surprising thing was that"
    } ]
  }, {
    "tStartMs": 840860,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "these lines on both sides of the ridge"
    } ]
  }, {
    "tStartMs": 842600,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "were mirror images of each other."
    } ]
  }, {
    "tStartMs": 844800,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The thing is that on the ridges below the sea,"
    } ]
  }, {
    "tStartMs": 847320,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "the plates of the earth kept on moving away from each other."
    } ]
  }, {
    "tStartMs": 850240,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "And new lava comes from the empty areas of the beach."
    } ]
  }, {
    "tStartMs": 853740,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "The lava keeps filling up and cools down with the sea water."
    } ]
  }, {
    "tStartMs": 857740,
    "dDurationMs": 8700,
    "segs": [ {
      "utf8": "But even here, the lava records the direction of the magnetic field of the magnetic minerals in the water."
    } ]
  }, {
    "tStartMs": 866440,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "The seabed under the sea was also working as a tape recorder,"
    } ]
  }, {
    "tStartMs": 870460,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "on which the entry of every magnetic flip on the Earth was recorded."
    } ]
  }, {
    "tStartMs": 874940,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "When the scientists observed and investigated this,"
    } ]
  }, {
    "tStartMs": 877980,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "So this tape recorder revealed the entire magnetic history of the Earth."
    } ]
  }, {
    "tStartMs": 887620,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And the numbers that they found here,"
    } ]
  }, {
    "tStartMs": 890260,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "shocked everyone."
    } ]
  }, {
    "tStartMs": 892820,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "After seeing them, the scientists understood that"
    } ]
  }, {
    "tStartMs": 895300,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "these zebra-like lines were caused by the magnetic field of the Earth"
    } ]
  }, {
    "tStartMs": 898060,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "being flipped over and over again."
    } ]
  }, {
    "tStartMs": 899860,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Whether it's the Pacific Ocean, the Atlantic Ocean, or the Indian Ocean,"
    } ]
  }, {
    "tStartMs": 902940,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "the same patterns were seen everywhere under the sea."
    } ]
  }, {
    "tStartMs": 906780,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "magnetic flips on the entire earth."
    } ]
  }, {
    "tStartMs": 912000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Scientists found that in the last 8 crore years,"
    } ]
  }, {
    "tStartMs": 914640,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "183 times magnetic poles have flipped."
    } ]
  }, {
    "tStartMs": 918320,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "On average, every 4.3 lakh years,"
    } ]
  }, {
    "tStartMs": 921980,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "once, magnetic poles change."
    } ]
  }, {
    "tStartMs": 925120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Listen to this carefully."
    } ]
  }, {
    "tStartMs": 926480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Every 4 lakh years, on average,"
    } ]
  }, {
    "tStartMs": 928640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the magnetic North Pole and magnetic South Pole of the Earth"
    } ]
  }, {
    "tStartMs": 932000,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "flip."
    } ]
  }, {
    "tStartMs": 933320,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And the most shocking thing,"
    } ]
  }, {
    "tStartMs": 934840,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "the last flip happened 7.8 lakh years ago."
    } ]
  }, {
    "tStartMs": 938940,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Now you might wonder, if the last flip was so far back,"
    } ]
  }, {
    "tStartMs": 942500,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "then what I talked about in the beginning of the video,"
    } ]
  }, {
    "tStartMs": 945140,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "is only 42,000 years back."
    } ]
  }, {
    "tStartMs": 947420,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "What happened then?"
    } ]
  }, {
    "tStartMs": 949380,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Actually, a temporary flip took place."
    } ]
  }, {
    "tStartMs": 951860,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The magnetic poles had temporarily turned,"
    } ]
  }, {
    "tStartMs": 954680,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "for a short time,"
    } ]
  }, {
    "tStartMs": 956200,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "and then returned to their original places."
    } ]
  }, {
    "tStartMs": 958100,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "This event is called the La Champe Excursion in scientific terms."
    } ]
  }, {
    "tStartMs": 961900,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "This was the time when both the magnetic poles had changed their places for about 800 years."
    } ]
  }, {
    "tStartMs": 967740,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "But then it returned to its original place."
    } ]
  }, {
    "tStartMs": 970480,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "In 2021, a study published in Science Journal,"
    } ]
  }, {
    "tStartMs": 973520,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "showed that the magnetic field strength of the Earth at that time"
    } ]
  }, {
    "tStartMs": 976800,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "was only 0-6%"
    } ]
  }, {
    "tStartMs": 979340,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "That means the magnetic field of the Earth was very weak."
    } ]
  }, {
    "tStartMs": 982660,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "We had almost no invisible shield."
    } ]
  }, {
    "tStartMs": 986860,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "We had nothing to protect ourselves from the dangerous radiation from space."
    } ]
  }, {
    "tStartMs": 991420,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "In this study of 2021, it was said that"
    } ]
  }, {
    "tStartMs": 993880,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "the Neanderthals of Europe also died because of this."
    } ]
  }, {
    "tStartMs": 997300,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "A whole species of humans"
    } ]
  }, {
    "tStartMs": 1000060,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "got extinct because of this one event."
    } ]
  }, {
    "tStartMs": 1003740,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "At the same time, the ozone layer got destroyed."
    } ]
  }, {
    "tStartMs": 1006620,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "And many species of animals and plants got extinct."
    } ]
  }, {
    "tStartMs": 1010300,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Like the giant kangaroo species in Australia."
    } ]
  }, {
    "tStartMs": 1014480,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "This research paper connects all these incidents with this flip."
    } ]
  }, {
    "tStartMs": 1018720,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And this is the reason why in 2019,"
    } ]
  }, {
    "tStartMs": 1020820,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "when the news of the magnetic North Pole's escape came,"
    } ]
  }, {
    "tStartMs": 1023120,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "there were claims on the internet that the poles were going to turn."
    } ]
  }, {
    "tStartMs": 1026000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "so that the Earth's magnetic field disappears."
    } ]
  }, {
    "tStartMs": 1028700,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "It was also claimed that when the poles were turned for a while,"
    } ]
  }, {
    "tStartMs": 1032540,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "a whole species of humans disappeared from the Earth."
    } ]
  }, {
    "tStartMs": 1037680,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "So the question is, will we also disappear like Neanderthals?"
    } ]
  }, {
    "tStartMs": 1041360,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "And even more importantly, when will the next flip take place?"
    } ]
  }, {
    "tStartMs": 1044920,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Many researchers believe that the next flip is overdue for a long time."
    } ]
  }, {
    "tStartMs": 1048520,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "Because on average, every 4.3 lakh years, these poles have flipped."
    } ]
  }, {
    "tStartMs": 1052980,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And the last flip happened 7.8 lakh years ago."
    } ]
  }, {
    "tStartMs": 1055980,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Two Italian researchers have given a point of no return."
    } ]
  }, {
    "tStartMs": 1060220,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Year 2034."
    } ]
  }, {
    "tStartMs": 1062460,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Plus minus 3 years."
    } ]
  }, {
    "tStartMs": 1063860,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "According to them, after 2034,"
    } ]
  }, {
    "tStartMs": 1066260,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "it would be inevitable to flip the Earth's magnetic field."
    } ]
  }, {
    "tStartMs": 1069340,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "But other scientists say that there is no fixed schedule for the flip."
    } ]
  }, {
    "tStartMs": 1073460,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "4.3 lakh years is just an average."
    } ]
  }, {
    "tStartMs": 1075780,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And these flips are random."
    } ]
  }, {
    "tStartMs": 1077820,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "It can take 10,000 years or 5 crore years."
    } ]
  }, {
    "tStartMs": 1082700,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "This has happened 11.8 crore years ago,"
    } ]
  }, {
    "tStartMs": 1086060,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and 8.3 crore years ago,"
    } ]
  }, {
    "tStartMs": 1088820,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "when there was no magnetic flip."
    } ]
  }, {
    "tStartMs": 1091460,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Another thing to note is that these flips are not sudden."
    } ]
  }, {
    "tStartMs": 1094840,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "It's not like you wake up in the morning and find out that"
    } ]
  }, {
    "tStartMs": 1097440,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the magnetic poles have flipped."
    } ]
  }, {
    "tStartMs": 1099480,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "To complete the last flip,"
    } ]
  }, {
    "tStartMs": 1101100,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "it took from 1,000 to 10,000 years according to different estimates."
    } ]
  }, {
    "tStartMs": 1105320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "If the flip starts today,"
    } ]
  }, {
    "tStartMs": 1107560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "your children and your children's children's whole life"
    } ]
  }, {
    "tStartMs": 1110840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "will be longer than the flip process."
    } ]
  }, {
    "tStartMs": 1113000,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And how weak the magnetic field will be when it flips,"
    } ]
  }, {
    "tStartMs": 1115960,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and how harmful it will be to humans and other animals."
    } ]
  }, {
    "tStartMs": 1119800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "There's not much bad news about this actually."
    } ]
  }, {
    "tStartMs": 1122680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "According to NASA, during the flip,"
    } ]
  }, {
    "tStartMs": 1124520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "the magnetic field is only weak."
    } ]
  }, {
    "tStartMs": 1126520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It doesn't disappear completely."
    } ]
  }, {
    "tStartMs": 1128200,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "According to most scientists,"
    } ]
  }, {
    "tStartMs": 1129640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "during the flip, the magnetic field's strength"
    } ]
  }, {
    "tStartMs": 1132280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "drops below 1 to the 4th."
    } ]
  }, {
    "tStartMs": 1134440,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "The event that took place in the Lashamp Excursion,"
    } ]
  }, {
    "tStartMs": 1136920,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "where the magnetic field was only up to 5%."
    } ]
  }, {
    "tStartMs": 1140000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "that it was a very extreme case."
    } ]
  }, {
    "tStartMs": 1142000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Most flips don't have this."
    } ]
  }, {
    "tStartMs": 1144000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And similarly, there is no solid evidence that"
    } ]
  }, {
    "tStartMs": 1147000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "magnetic poles flip can cause mass extinction."
    } ]
  }, {
    "tStartMs": 1151000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The study of 2021, in which the claim was made,"
    } ]
  }, {
    "tStartMs": 1154000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "was constantly questioned."
    } ]
  }, {
    "tStartMs": 1156000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "That same year, 10 scientists published another study,"
    } ]
  }, {
    "tStartMs": 1159000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "which, according to them,"
    } ]
  }, {
    "tStartMs": 1161000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "there is no proven evidence of the extinction of Neanderthals and other species because of the Lasham."
    } ]
  }, {
    "tStartMs": 1166000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The last big pole flips,"
    } ]
  }, {
    "tStartMs": 1168000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "there is no major change in the fossils of the trees and animals of that time."
    } ]
  }, {
    "tStartMs": 1173000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Nor has there been any mass extinction."
    } ]
  }, {
    "tStartMs": 1176000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So the thing is that research is still going on on this."
    } ]
  }, {
    "tStartMs": 1178000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "For sure, these things cannot be called for sure."
    } ]
  }, {
    "tStartMs": 1181000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Yes, one thing is for sure that the species of those animals will definitely suffer losses"
    } ]
  }, {
    "tStartMs": 1185000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that are found through the help of magnetic fields."
    } ]
  }, {
    "tStartMs": 1188000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Like whales, butterflies, sea turtles and migratory birds."
    } ]
  }, {
    "tStartMs": 1193000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "These sea turtles travel thousands of kilometers to lay eggs on the same beach where they were born."
    } ]
  }, {
    "tStartMs": 1199000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "And they identify the beach with the help of the magnetic signature."
    } ]
  }, {
    "tStartMs": 1205000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So it can be said that the next time magnetic poles flip,"
    } ]
  }, {
    "tStartMs": 1209000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "there will be a huge impact on the species of all these animals."
    } ]
  }, {
    "tStartMs": 1215000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Thankfully, we don't live in jungles and caves today."
    } ]
  }, {
    "tStartMs": 1219000,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "if cosmic radiation increases,"
    } ]
  }, {
    "tStartMs": 1221240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and the magnetic field weakens,"
    } ]
  }, {
    "tStartMs": 1223240,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "we can take shelter in our buildings,"
    } ]
  }, {
    "tStartMs": 1225800,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "we can take shelter in our homes."
    } ]
  }, {
    "tStartMs": 1227560,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Actually, the biggest threat is that thing"
    } ]
  }, {
    "tStartMs": 1230280,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "which was not present on Earth during the previous pole flipping."
    } ]
  }, {
    "tStartMs": 1233800,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And that thing is called modern technology."
    } ]
  }, {
    "tStartMs": 1238600,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Our today's majority technology is based on electromagnetic fields."
    } ]
  }, {
    "tStartMs": 1242440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And any major change in electromagnetic fields"
    } ]
  }, {
    "tStartMs": 1245640,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "can impact this technology on a large scale."
    } ]
  }, {
    "tStartMs": 1248920,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Especially satellites."
    } ]
  }, {
    "tStartMs": 1250480,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Now, what all can happen here"
    } ]
  }, {
    "tStartMs": 1252280,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "due to its reflection on the Bermuda Triangle"
    } ]
  }, {
    "tStartMs": 1254000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "between South America and Africa,"
    } ]
  }, {
    "tStartMs": 1256000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "the region where the magnetic field on Earth is a little weak,"
    } ]
  }, {
    "tStartMs": 1260000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "and the radiation coming from space reaches the satellites there more."
    } ]
  }, {
    "tStartMs": 1265000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "This is why the data of Hubble-like telescopes starts to get glitches."
    } ]
  }, {
    "tStartMs": 1269000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And the region in space is called the Bermuda Triangle of Space."
    } ]
  }, {
    "tStartMs": 1273000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Now think about it, if during the flip, the magnetic field on the entire Earth becomes weak,"
    } ]
  }, {
    "tStartMs": 1278000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "then this Bermuda Triangle will not only be limited to one region,"
    } ]
  }, {
    "tStartMs": 1281000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "but will spread all over the Earth."
    } ]
  }, {
    "tStartMs": 1283000,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "The good news is that there is no evidence that the magnetic North Pole is actually being flipped today."
    } ]
  }, {
    "tStartMs": 1290000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And the shift that is happening from its place is not happening because the world is ending."
    } ]
  }, {
    "tStartMs": 1295000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "It is shifting because it has never been on one place."
    } ]
  }, {
    "tStartMs": 1299000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Today in 2026, its speed has also decreased."
    } ]
  }, {
    "tStartMs": 1302000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "The magnetic North Pole which was moving from 50 to 60 km per year to Siberia,"
    } ]
  }, {
    "tStartMs": 1308000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "now its speed has decreased to only 35 to 36 km per year."
    } ]
  }, {
    "tStartMs": 1313000,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "This is something that has changed over time."
    } ]
  }, {
    "tStartMs": 1315600,
    "dDurationMs": 6840,
    "segs": [ {
      "utf8": "The question is, will humans be present to see that moment next time when the poles flip?"
    } ]
  }, {
    "tStartMs": 1322440,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Or will they have already finished themselves before then?"
    } ]
  }, {
    "tStartMs": 1328120,
    "dDurationMs": 6280,
    "segs": [ {
      "utf8": "Now, if you want to know what happened to the other species of humans, like Neanderthals,"
    } ]
  }, {
    "tStartMs": 1334400,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "how did they become extinct?"
    } ]
  }, {
    "tStartMs": 1336560,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "I have explained that in detail in this video."
    } ]
  }, {
    "tStartMs": 1340320,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "You can click here to watch it."
    } ]
  }, {
    "tStartMs": 1341960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And don't forget to take advantage of the Diwali sale on Dhruv Rathee Academy."
    } ]
  }, {
    "tStartMs": 1344960,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Flat 50% off on every course."
    } ]
  }, {
    "tStartMs": 1347880,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "You can click here and join."
    } ]
  }, {
    "tStartMs": 1349840,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Thank you very much."
    } ]
  } ]
}
